<?xml version="1.0" encoding="UTF-8"?>
<templates id="point_of_sale.template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//ReceiptHeader" position="before">
            <img t-if="this.env.services.pos.config.image"
                 t-attf-src="/web/image?model=pos.config&amp;field=image&amp;id={{ this.env.services.pos.config.id }}"
                 style="width:10%; display:block; margin:0 auto;"/>
            <img t-if="!this.env.services.pos.config.image"
                 t-attf-src="/web/image?model=res.company&amp;field=favicon&amp;id={{ this.env.services.pos.company.id }}"
                 style="width:10%; display:block; margin:0 auto;"/>
        </xpath>
    </t>
</templates>
