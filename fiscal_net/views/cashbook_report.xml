<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="report_cash_book_action" model="ir.actions.report">
            <field name="name">Cash Book Report</field>
            <field name="model">pos.session</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fiscal_net.report_cash_book_view_template</field>
            <field name="report_file">fiscal_net.report_cash_book_view_template</field>
        </record>

        <template id="report_cash_book_view_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <style>
                            .cash-register-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 10px;
                            margin-top: 20px;
                            }
                            .cash-register-table th,
                            .cash-register-table td {
                            border: 1px solid #000;
                            padding: 4px;
                            text-align: left;
                            }
                            .cash-register-table th {
                            background-color: #f0f0f0;
                            font-weight: bold;
                            text-align: center;
                            }
                            .text-right {
                            text-align: right !important;
                            }
                            .text-center {
                            text-align: center !important;
                            }
                            .bold {
                            font-weight: bold;
                            }
                            .header-info {
                            display: flex;
                            justify-content: space-between;
                            margin-bottom: 10px;
                            }
                            .company-name {
                            color: #0066cc;
                            font-weight: bold;
                            font-size: 14px;
                            }
                            .report-title {
                            text-align: center;
                            font-size: 16px;
                            font-weight: bold;
                            margin: 20px 0;
                            }
                        </style>

                        <!-- Header -->
                        <div class="header-info">
                            <div>
                                <div>Unitatea:
                                    <span class="company-name" t-esc="company.name"/>
                                </div>
                            </div>
                            <div>
                                <div>Contul casa</div>
                                <div class="bold" t-esc="session.config_id.name"/>
                            </div>
                        </div>

                        <!-- Report Title -->
                        <div class="report-title">REGISTRU DE CASA</div>

                        <!-- Cash Register Table -->
                        <table class="cash-register-table">
                            <thead>
                                <tr>
                                    <th rowspan="2">Nr. crt</th>
                                    <th colspan="3">Data</th>
                                    <th rowspan="2">Nr. act. casa</th>
                                    <th rowspan="2">Nr. anexa</th>
                                    <th rowspan="2">Explicatie</th>
                                    <th rowspan="2">Incasari</th>
                                    <th rowspan="2">Plati</th>
                                </tr>
                                <tr>
                                    <th>Ziua</th>
                                    <th>Luna</th>
                                    <th>Anul</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Initial Balance -->
                                <tr class="bold">
                                    <td></td>
                                    <td colspan="5"></td>
                                    <td class="bold">SOLD INITIAL</td>
                                    <td class="text-right bold" t-esc="'{:.2f}'.format(initial_balance)"/>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td colspan="5"></td>
                                    <td>Report / Sold ziua precedenta
                                        <t t-esc="date_start.strftime('%d-%m-%Y') if date_start else ''"/>
                                    </td>
                                    <td class="text-right" t-esc="'{:.2f}'.format(initial_balance)"/>
                                    <td></td>
                                </tr>

                                <!-- Cash Transactions -->
                                <t t-set="line_number" t-value="1"/>
                                <t t-foreach="cash_transactions" t-as="transaction">
                                    <!--                                <t t-if="transaction['type'] in ['cash_in', 'cash_out']">-->
<!--                                    <t t-if="transaction['type'] in ['cash_in', 'cash_out'] and 'cash difference' not in transaction['description'].lower()">-->
                                    <t t-if="transaction['type'] in ['cash_in', 'pos_cash_order', 'cash_out'] and 'cash difference' not in transaction['description'].lower()">
                                        <tr>
                                            <td class="text-center" t-esc="line_number"/>
                                            <td class="text-center"
                                                t-esc="transaction['date'].strftime('%d') if transaction['date'] else ''"/>
                                            <td class="text-center"
                                                t-esc="transaction['date'].strftime('%m') if transaction['date'] else ''"/>
                                            <td class="text-center"
                                                t-esc="transaction['date'].strftime('%Y') if transaction['date'] else ''"/>
                                            <td t-esc="transaction['reference']"/>
                                            <td></td>
                                            <td t-esc="transaction['description']"/>
                                            <td class="text-right"
                                                t-esc="'{:.2f}'.format(transaction['amount_in']) if transaction['amount_in'] > 0 else ''"/>
                                            <td class="text-right"
                                                t-esc="'{:.2f}'.format(transaction['amount_out']) if transaction['amount_out'] > 0 else ''"/>
                                        </tr>
                                        <t t-set="line_number" t-value="line_number + 1"/>
                                    </t>
                                </t>

                                <!-- Subtotal -->
                                <tr class="bold">
                                    <td colspan="7">Rulaj zi</td>
                                    <td class="text-right bold" t-esc="'{:.2f}'.format(total_cash_in)"/>
                                    <td class="text-right bold" t-esc="'{:.2f}'.format(total_cash_out)"/>
                                </tr>

                                <!-- Final Balance -->
                                <tr class="bold">
                                    <td colspan="7">Sold Final ziua
                                        <t t-esc="date_end.strftime('%d-%m-%Y') if date_end else ''"/>
                                    </td>
                                    <td class="text-right bold" t-esc="'{:.2f}'.format(final_balance)"/>
                                    <td></td>
                                </tr>

                                <!-- Total -->
                                <!--                                <tr class="bold">-->
                                <!--                                    <td colspan="7">De reportat pagina / TOTAL</td>-->
                                <!--                                    <td class="text-right bold" t-esc="'{:.2f}'.format(final_balance)"/>-->
                                <!--                                    <td></td>-->
                                <!--                                </tr>-->
                            </tbody>
                        </table>

                        <!-- Footer -->
                        <div style="margin-top: 30px; display: flex; justify-content: space-between;">
                            <div>
                                <div>Casier:</div>
                                <div style="margin-top: 20px;">_________________</div>
                            </div>
                            <div>
                                <div>Compartiment financiar-contabil:</div>
                                <div style="margin-top: 20px;">_________________</div>
                            </div>
                        </div>

                        <div style="margin-top: 20px; font-size: 8px;">
                            Pagina 1 din 1
                        </div>
                    </div>
                </t>
            </t>
        </template>


